{
  "entities": {
    "Question": {
      "title": "Question",
      "description": "Quiz questions for exam prep in Khmer civil service",
      "type": "object",
      "properties": {
        "subject": { "type": "string" },
        "question": { "type": "string" },
        "type": { "type": "string", "enum": ["mcq", "short", "explanation"] },
        "options": { "type": "array" },
        "correct": { "type": "number" },
        "answer": { "type": "string" },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["subject", "question", "type"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Category/Subject entity",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["mcq", "short", "explanation"] },
        "isActive": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "type"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User suggestions and feedback",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["username", "text"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "System broadcast announcement",
      "type": "object",
      "properties": {
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "type": { "type": "string", "enum": ["info", "success", "warning"] }
      },
      "required": ["message", "timestamp"]
    },
    "LoginRecord": {
      "title": "LoginRecord",
      "description": "Access log entry",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "passwordUsed": { "type": "string" },
        "timestamp": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["username", "timestamp", "role"]
    },
    "PresenceRecord": {
      "title": "PresenceRecord",
      "description": "Real-time user heartbeat",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "lastSeen": { "type": "string" }
      },
      "required": ["username", "role", "lastSeen"]
    },
    "PaidUser": {
      "title": "PaidUser",
      "description": "Registered paid user account with permanent access",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string" },
        "paidAt": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "pending", "revoked"] },
        "permanentAccess": { "type": "boolean" },
        "transactionRef": { "type": "string" },
        "method": { "type": "string" },
        "note": { "type": "string" }
      },
      "required": ["username", "amount", "currency", "paidAt", "status", "permanentAccess"]
    },
    "BotCommandConfig": {
      "title": "BotCommandConfig",
      "description": "Admin-editable Command Bot reply templates and menu descriptions",
      "type": "object",
      "properties": {
        "command": { "type": "string", "maxLength": 32 },
        "titleKh": { "type": "string", "maxLength": 120 },
        "descriptionKh": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "maxLength": 250 },
        "body": { "type": "string", "maxLength": 4000 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "imageAlt": { "type": "string", "maxLength": 200 },
        "actions": { "type": "array" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["command", "descriptionKh", "title", "body", "actions"]
    }
  },
  "firestore": {
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Collection of all test questions"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Collection of test subjects"
    },
    "/feedbacks/{feedbackId}": {
      "schema": "Feedback",
      "description": "User feedback messages"
    },
    "/notifications/{notificationId}": {
      "schema": "AppNotification",
      "description": "System broadcast notifications"
    },
    "/logins/{loginId}": {
      "schema": "LoginRecord",
      "description": "Login history records"
    },
    "/presence/{presenceId}": {
      "schema": "PresenceRecord",
      "description": "Active user heartbeat status"
    },
    "/paid_users/{paidUserId}": {
      "schema": "PaidUser",
      "description": "Collection of accounts with verified permanent access"
    },
    "/bot_commands/{commandId}": {
      "schema": "BotCommandConfig",
      "description": "Customized Command Bot messages, menu descriptions, and action buttons"
    }
  }
}
